{
  "name": "libraeditor",
  "version": "2.0.0",
  "description": "Editor WYSIWYG de bloques al estilo Notion en ECMAScript 5 puro, sin dependencias. Incluye wrapper de React opcional.",
  "keywords": [
    "wysiwyg",
    "editor",
    "rich-text",
    "block-editor",
    "notion",
    "react",
    "es5",
    "zero-dependencies"
  ],
  "license": "MIT",
  "author": "Marcos Esperón",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcosesperon/LibraEditor.git"
  },
  "main": "libraeditor.js",
  "module": "libraeditor.js",
  "types": "libraeditor.d.ts",
  "exports": {
    ".": {
      "types": "./libraeditor.d.ts",
      "default": "./libraeditor.js"
    },
    "./react": {
      "types": "./react/index.d.ts",
      "import": "./react/LibraEditor.mjs",
      "default": "./react/LibraEditor.mjs"
    },
    "./style.css": "./libraeditor.css",
    "./libraeditor.css": "./libraeditor.css"
  },
  "files": [
    "libraeditor.js",
    "libraeditor.css",
    "libraeditor.d.ts",
    "react/LibraEditor.mjs",
    "react/index.d.ts",
    "react/README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  }
}
